@page "/locations/{locationId:int}/workers"
@using Core.DTOs
@using UIinterface.Services
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Location Details</PageTitle>

@if (location == null)
{
    <p>Loading...</p>
}
else
{
    <h3>Location: @location.Name</h3>
    <p>@location.Description</p>

    <h4>Bosses:</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var boss in location.Bosses)
            {
                <tr>
                    <td>@boss.Id</td>
                    <td>@boss.FirstName</td>
                    <td>@boss.LastName</td>
                    <td>@boss.Email</td>
                    <td>@boss.Phone</td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Workers:</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var worker in location.Workers)
            {
                <tr>
                    <td>@worker.Id</td>
                    <td>@worker.FirstName</td>
                    <td>@worker.LastName</td>
                    <td>@worker.Email</td>
                    <td>@worker.Phone</td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-primary" @onclick="GoBack">Back</button>
}

@code {
    [Parameter]
    public int LocationId { get; set; }

    private LocationDto location;

    protected override async Task OnInitializedAsync()
    {
        location = await LocationService.GetByIdAsync(LocationId);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/locations");
    }
}
