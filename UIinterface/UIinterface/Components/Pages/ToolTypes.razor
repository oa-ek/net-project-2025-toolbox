@page "/tooltypes"
@using Core.DTOs
@using UIinterface.Services
@inject ToolTypeService ToolTypeService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Tool Types</PageTitle>

<h3>Tool Types</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var toolType in toolTypes)
            {
                <tr>
                    <td>@toolType.Name</td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditToolType(toolType.Id)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => DeleteToolType(toolType.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary" @onclick="AddToolType">Add New Tool Type</button>
}

@if (isEditing || isAdding)
{
    <EditForm Model="toolType" OnValidSubmit="SaveToolType">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="toolType.Name" />
            <ValidationMessage For="@(() => toolType.Name)" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    private List<ToolTypeDto> toolTypes = new();
    private ToolTypeDto toolType = new ToolTypeDto();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

    protected override async Task OnInitializedAsync()
    {
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddToolType()
    {
        toolType = new ToolTypeDto();
        isAdding = true;
        isEditing = false;
    }

    private async Task EditToolType(int id)
    {
        toolType = await ToolTypeService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SaveToolType()
    {
        if (isEditing)
        {
            await ToolTypeService.UpdateAsync(toolType.Id, toolType);
        }
        else if (isAdding)
        {
            await ToolTypeService.AddAsync(toolType);
        }

        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }

    private async Task DeleteToolType(int id)
    {
        await ToolTypeService.DeleteAsync(id);
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }
}
