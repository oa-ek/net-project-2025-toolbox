@page "/workers"
@using Core.DTOs
@using UIinterface.Services
@inject WorkerService WorkerService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Workers</PageTitle>

<h3>Workers</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Position</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var worker in workers)
            {
                <tr>
                    <td>@worker.FirstName</td>
                    <td>@worker.LastName</td>
                    <td>@worker.Email</td>
                    <td>@worker.Phone</td>
                    <td>@worker.PositionName</td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditWorker(worker.Id)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => DeleteWorker(worker.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary" @onclick="AddWorker">Add New Worker</button>
}

@code {
    private List<WorkerDto> workers = new List<WorkerDto>();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        workers = (await WorkerService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddWorker()
    {
        Navigation.NavigateTo("/add-edit-worker");
    }

    private void EditWorker(int id)
    {
        Navigation.NavigateTo($"/add-edit-worker/{id}");
    }

    private async Task DeleteWorker(int id)
    {
        await WorkerService.DeleteAsync(id);
        workers = (await WorkerService.GetAllAsync()).ToList();
    }
}
