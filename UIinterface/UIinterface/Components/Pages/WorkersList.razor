@page "/workers"
@using Core.DTOs
@using UIinterface.Services
@inject WorkerService WorkerService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Workers</PageTitle>

<h3>Workers</h3>

<div class="mb-3">
    <label for="search" class="form-label">Search</label>
    <InputText id="search" class="form-control" @bind-Value="searchTerm" @oninput="SearchWorkers" />
</div>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var worker in workers)
            {
                <tr>
                    <td>@worker.FirstName</td>
                    <td>@worker.LastName</td>
                    <td>@worker.Email</td>
                    <td>@worker.Phone</td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditWorker(worker.Id)">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary" @onclick="AddWorker">Add New Worker</button>
}

@code {
    private List<WorkerDto> workers = new();
    private string searchTerm = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        workers = (await WorkerService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private async Task SearchWorkers(ChangeEventArgs e)
    {
        searchTerm = e.Value.ToString();
        if (string.IsNullOrEmpty(searchTerm))
        {
            workers = (await WorkerService.GetAllAsync()).ToList();
        }
        else
        {
            workers = (await WorkerService.SearchAsync(searchTerm)).ToList();
        }
    }

    private void AddWorker()
    {
        Navigation.NavigateTo("/add-edit-worker");
    }

    private void EditWorker(int id)
    {
        Navigation.NavigateTo($"/add-edit-worker/{id}");
    }
}
