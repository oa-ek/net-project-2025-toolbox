@page "/"
@rendermode InteractiveServer

@inject NavigationManager Navigation

<PageTitle>Home</PageTitle>

<h1>Вітаємо у сервісі ToolTrack</h1>

<button class="custom-button" @onclick="NavigateToLocation">Go to Locations</button>



@code {
    private void NavigateToLocation()
    {
        Navigation.NavigateTo("/locations");
    }
}


<button class="btn btn-primary" @onclick="NavigateToBoss">Go to Boss</button>
@code {
    private void NavigateToBoss()
    {
        Navigation.NavigateTo("/bosses");
    }
}

<button class="btn btn-primary" @onclick="NavigateToSystemAdmin">Go to System Admin</button>
@code {
    private void NavigateToSystemAdmin()
    {
        Navigation.NavigateTo("/systemadmins");
    }
}



<button class="btn btn-primary" @onclick="NavigateToPosition">Go to Positions</button>
@code {
    private void NavigateToPosition()
    {
        Navigation.NavigateTo("/positions");
    }
}