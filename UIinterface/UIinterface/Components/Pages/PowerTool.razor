@page "/powertools"
@using Core.DTOs
@using UIinterface.Services
@inject PowerToolService PowerToolService
@inject ToolTypeService ToolTypeService
@inject ConditionService ConditionService
@inject ToolModelService ToolModelService
@inject PowerSupplyTypeService PowerSupplyTypeService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Power Tools</PageTitle>

<h3>Power Tools</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Tool Type</th>
                <th>Condition</th>
                <th>Tool Model</th>
                <th>Power Supply Type</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var powerTool in powerTools)
            {
                <tr>
                    <td>@toolTypes.FirstOrDefault(t => t.Id == powerTool.ToolTypeId)?.Name</td>
                    <td>@conditions.FirstOrDefault(c => c.Id == powerTool.ConditionId)?.Name</td>
                    <td>@toolModels.FirstOrDefault(m => m.Id == powerTool.ToolModelId)?.Name</td>
                    <td>@powerSupplyTypes.FirstOrDefault(p => p.Id == powerTool.PowerSupplyTypeId)?.Name</td>
                    <td>@powerTool.Price</td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditPowerTool(powerTool.Id)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => DeletePowerTool(powerTool.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary" @onclick="AddPowerTool">Add New Power Tool</button>
}

@code {
    private List<PowerToolDto> powerTools = new();
    private List<ToolTypeDto> toolTypes = new();
    private List<ConditionDto> conditions = new();
    private List<ToolModelDto> toolModels = new();
    private List<PowerSupplyTypeDto> powerSupplyTypes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        powerTools = (await PowerToolService.GetAllAsync()).ToList();
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
        conditions = (await ConditionService.GetAllAsync()).ToList();
        toolModels = (await ToolModelService.GetAllAsync()).ToList();
        powerSupplyTypes = (await PowerSupplyTypeService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddPowerTool()
    {
        Navigation.NavigateTo("/powertools/addedit");
    }

    private void EditPowerTool(int id)
    {
        Navigation.NavigateTo($"/powertools/addedit/{id}");
    }

    private async Task DeletePowerTool(int id)
    {
        await PowerToolService.DeleteAsync(id);
        powerTools = (await PowerToolService.GetAllAsync()).ToList();
    }
}

