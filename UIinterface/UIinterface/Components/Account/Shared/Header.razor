@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<header >
    <div class="d-flex align-items-center gap-3">
        <h1 class="m-0">ToolTrack</h1>
        <img src="Photos/logo.jpeg" alt="Logo" class="logo me-3" /> <!-- Логотип -->
        <!--<h1 class="m-0">ToolTrack</h1>  Назва сайту -->
    </div>
    <nav class="nav">
        <NavLink class="nav-link text-white" href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink class="nav-link text-white" href="auth">Auth Required</NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink class="nav-link text-white" href="Account/Manage">@context.User.Identity?.Name</NavLink>
                <form action="Account/Logout" method="get" class="d-inline">
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="btn-link nav-link text-white">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-link text-white" href="Account/Register">Register</NavLink>
                <NavLink class="nav-link text-white" href="Account/Login">Login</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}