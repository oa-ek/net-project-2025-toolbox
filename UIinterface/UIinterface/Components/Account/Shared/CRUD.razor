@page "/admin"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sunflower:wght@300&display=swap" rel="stylesheet">

<PageTitle>Anmin panel</PageTitle>

<div class="admin-panel">
    <h1 class="admin-title">Admin Panel</h1>

    <div class="admin-buttons">
        <button class="custom-button" @onclick="NavigateToLocation">Go to Locations</button>
        <button class="custom-button" @onclick="NavigateToBoss">Go to Boss</button>
    </div>
</div>

@code {
    private void NavigateToLocation()
    {
        Navigation.NavigateTo("/locations");
    }
    }

    @code {
    private void NavigateToBoss()
    {
        Navigation.NavigateTo("/bosses");
    }
    }




