@page "/admin"
@inject NavigationManager Navigation

<PageTitle>Admin Panel</PageTitle>

<div class="admin-panel">
    <h1 class="admin-title">Admin Panel</h1>

    <div class="admin-buttons">
        <button class="custom-button" @onclick="NavigateToLocation">Go to Locations</button>
        <button class="custom-button" @onclick="NavigateToBoss">Go to Boss</button>
    </div>
</div>

@code {
    private void NavigateToLocation()
    {
        Navigation.NavigateTo("/locations");
    }

    private void NavigateToBoss()
    {
        Navigation.NavigateTo("/bosses");
    }
}
