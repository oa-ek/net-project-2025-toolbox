@inherits LayoutComponentBase
@using UIinterface.Components.Account.Shared

<div class="d-flex flex-column min-vh-100"> <!-- Додаємо flexbox -->
    <Header /> <!-- Хедер з інтегрованим меню -->

    <div class="flex-grow-1"> <!-- Контент займає весь доступний простір -->
        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    <Footer /> <!-- Футер прикріплений знизу -->
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
