@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

<header>
    <div class="d-flex align-items-center gap-3">
        <h1 class="m-0">ToolTrack</h1>
        <img src="Photos/logo.jpeg" alt="Logo" class="logo me-3" /> <!-- Логотип -->
        <!--<h1 class="m-0">ToolTrack</h1>  Назва сайту -->
    </div>
    <nav class="nav">
        <NavLink class="nav-link text-white" href="" Match="NavLinkMatch.All">Home</NavLink>

        <AuthorizeView>
            <Authorized Context="outerContext">
                <AuthorizeView Roles="Admin,Boss" Context="adminContext">
                    <NavLink class="nav-link text-white" href="admin">Admin Panel</NavLink>
                </AuthorizeView>

                <!-- КНОПКА MANAGE ДЛЯ Worker, Admin, Boss -->
                <AuthorizeView Roles="Worker,Admin,Boss" Context="manageContext">
                    <NavLink class="nav-link text-white" href="tools-management">Manage</NavLink>
                </AuthorizeView>

                <NavLink class="nav-link text-white" href="Account/Manage">@outerContext.User.Identity?.Name</NavLink>
                <form action="Account/Logout" method="post" class="d-inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                    <button type="submit" class="btn-link nav-link text-white">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-link text-white" href="Account/Register">Register</NavLink>
                <NavLink class="nav-link text-white" href="Account/Login">Login</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}