@page "/handtools/addedit/{Id:int?}"
@using Core.DTOs
@using UIinterface.Services
@inject HandToolService HandToolService
@inject BrandService BrandService
@inject ConditionService ConditionService
@inject ToolTypeService ToolTypeService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Add/Edit Hand Tool</PageTitle>

<div class="page-container">
    <h3 class="title">@(isEditing ? "Edit Hand Tool" : "Add Hand Tool")</h3>

    <EditForm Model="handTool" OnValidSubmit="SaveHandTool">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="brandId">Brand</label>
            <InputSelect id="brandId" class="form-control" @bind-Value="handTool.BrandId">
                <option value="">Select a brand</option>
                @foreach (var brand in brands)
                {
                    <option value="@brand.Id">@brand.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => handTool.BrandId)" />
        </div>

        <div class="form-group">
            <label for="conditionId">Condition</label>
            <InputSelect id="conditionId" class="form-control" @bind-Value="handTool.ConditionId">
                <option value="">Select a condition</option>
                @foreach (var condition in conditions)
                {
                    <option value="@condition.Id">@condition.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => handTool.ConditionId)" />
        </div>

        <div class="form-group">
            <label for="toolTypeId">Tool Type</label>
            <InputSelect id="toolTypeId" class="form-control" @bind-Value="handTool.ToolTypeId">
                <option value="">Select a tool type</option>
                @foreach (var toolType in toolTypes)
                {
                    <option value="@toolType.Id">@toolType.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => handTool.ToolTypeId)" />
        </div>

        <div class="form-group">
            <label for="price">Price</label>
            <InputNumber id="price" class="form-control" @bind-Value="handTool.Price" />
            <ValidationMessage For="@(() => handTool.Price)" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-save">💾 Save</button>
            <button type="button" class="btn btn-cancel" @onclick="Cancel">↩️ Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private HandToolDto handTool = new HandToolDto();
    private List<BrandDto> brands = new();
    private List<ConditionDto> conditions = new();
    private List<ToolTypeDto> toolTypes = new();
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        brands = (await BrandService.GetAllAsync()).ToList();
        conditions = (await ConditionService.GetAllAsync()).ToList();
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();

        if (Id.HasValue)
        {
            handTool = await HandToolService.GetByIdAsync(Id.Value);
            isEditing = true;
        }
    }

    private async Task SaveHandTool()
    {
        if (isEditing)
        {
            await HandToolService.UpdateAsync(handTool.Id, handTool);
        }
        else
        {
            await HandToolService.AddAsync(handTool);
        }

        Navigation.NavigateTo("/handtools");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/handtools");
    }
}
