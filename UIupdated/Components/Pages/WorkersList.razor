@page "/workers"
@using Core.DTOs
@using UIinterface.Services
@using UIupdated.Services
@inject WorkerService WorkerService
@inject IUserService UserService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Workers</PageTitle>

<div class="page-container">
    <h3 class="title">Workers</h3>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Position</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var worker in workers)
                {
                    <tr>
                        <td>@worker.FirstName</td>
                        <td>@worker.LastName</td>
                        <td>@worker.Email</td>
                        <td>@worker.Phone</td>
                        <td>@worker.PositionName</td>
                        <td>
                            <button class="btn btn-save" @onclick="() => EditWorker(worker.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeleteWorker(worker.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button class="btn btn-save" @onclick="AddWorker">➕ Add New Worker</button>
            <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
            @code {
            private void GoBack()
            {
                Navigation.NavigateTo("/admin/people");
            }
        }
    </div>
    }
</div>

@code {
    private List<WorkerDto> workers = new List<WorkerDto>();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        workers = (await WorkerService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddWorker()
    {
        Navigation.NavigateTo("/add-edit-worker");
    }

    private void EditWorker(int id)
    {
        Navigation.NavigateTo($"/add-edit-worker/{id}");
    }

    private async Task DeleteWorker(int id)
    {
        var worker = workers.FirstOrDefault(w => w.Id == id);
        if (worker == null)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Worker with id {id} not found.");
            return;
        }

        var user = await UserService.GetUserByEmailAsync(worker.Email);
        if (user != null)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"User ID: {user.Id}");

            var workerRole = await UserService.GetRoleByNameAsync("Worker");
            if (workerRole != null)
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Role ID: {workerRole.Id}");

                var removed = await UserService.RemoveRoleByIdAsync(user.Id, workerRole.Id);
                if (removed)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"User with ID {user.Id} had role {workerRole.Id} removed.");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"Failed to remove role {workerRole.Id} from user {user.Id}.");
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Role 'Worker' not found.");
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", $"User with email {worker.Email} not found.");
        }

        await WorkerService.DeleteAsync(worker.Id);
        workers = (await WorkerService.GetAllAsync()).ToList();
        StateHasChanged();
    }
}
