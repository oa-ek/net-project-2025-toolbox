@page "/positions"
@using Core.DTOs
@using UIinterface.Services
@inject PositionService PositionService
@inject BossService BossService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Boss")]



<PageTitle>Positions</PageTitle>

<div class="page-container">
    <h3 class="title">Positions</h3>

    @if (isLoading)
    {
        <p class="loading-text">Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th class="table-header">Name</th>
                    <th class="table-header">Salary Per Hour</th>
                    <th class="table-header">Boss</th>
                    <th class="table-header">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var position in positions)
                {
                    <tr>
                        <td class="table-cell">@position.Name</td>
                        <td class="table-cell">@position.SalaryPerHour</td>
                        <td class="table-cell">@position.BossName</td>
                        <td class="table-cell">
                            <button class="btn btn-edit" @onclick="() => EditPosition(position.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeletePosition(position.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-add" @onclick="AddPosition">➕ Add New</button>
        <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
    }

    @if (isEditing || isAdding)
    {
        <EditForm Model="position" OnValidSubmit="SavePosition">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="name" class="form-label">Name</label>
                <InputText id="name" class="form-input" @bind-Value="position.Name" />
                <ValidationMessage For="@(() => position.Name)" />
            </div>

            <div class="form-group">
                <label for="salaryPerHour" class="form-label">Salary Per Hour</label>
                <InputNumber id="salaryPerHour" class="form-input" @bind-Value="position.SalaryPerHour" />
                <ValidationMessage For="@(() => position.SalaryPerHour)" />
            </div>

            <div class="form-group">
                <label for="bossId" class="form-label">Boss</label>
                <InputSelect id="bossId" class="form-input" @bind-Value="position.BossId">
                    <option value="">Select a boss</option>
                    @foreach (var boss in bosses)
                    {
                        <option value="@boss.Id">@boss.FirstName @boss.LastName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => position.BossId)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">💾 Save</button>
                <button class="btn btn-cancel" @onclick="Cancel">↩️ Cancel</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private List<PositionDto> positions = new();
    private PositionDto position = new PositionDto();
    private List<BossDto> bosses = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

        private void GoBack()
    {
        Navigation.NavigateTo("/admin/other");
    }

    protected override async Task OnInitializedAsync()
    {
        positions = (await PositionService.GetAllAsync()).ToList();
        bosses = (await BossService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddPosition()
    {
        position = new PositionDto
            {
                Name = string.Empty,        
                SalaryPerHour = 1,
                BossId = bosses.FirstOrDefault()?.Id ?? 0
            };
        isAdding = true;
        isEditing = false;
    }


    private async Task EditPosition(int id)
    {
        position = await PositionService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SavePosition()
    {
        Console.WriteLine($"Name: '{position.Name}'");
        Console.WriteLine($"Salary: {position.SalaryPerHour}");
        Console.WriteLine($"BossId: {position.BossId}");

        if (string.IsNullOrWhiteSpace(position.Name))
        {
            Console.WriteLine("⚠️ Position Name is null or empty!");
        }

        if (isEditing)
            await PositionService.UpdateAsync(position.Id, position);
        else if (isAdding)
            await PositionService.AddAsync(position);

        positions = (await PositionService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }


    private async Task DeletePosition(int id)
    {
        await PositionService.DeleteAsync(id);
        positions = (await PositionService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }
}
