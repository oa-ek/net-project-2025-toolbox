@page "/conditions"
@using Core.DTOs
@using UIinterface.Services
@inject ConditionService ConditionService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Conditions</PageTitle>

<div class="page-container">
    <h3 class="title">Conditions</h3>

    @if (isLoading)
    {
        <p class="loading-text">Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th class="table-header">Name</th>
                    <th class="table-header">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var condition in conditions)
                {
                    <tr>
                        <td class="table-cell">@condition.Name</td>
                        <td class="table-cell">
                            <button class="btn btn-edit" @onclick="() => EditCondition(condition.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeleteCondition(condition.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-add" @onclick="AddCondition">➕ Add New</button>
        <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
    }

    @if (isEditing || isAdding)
    {
        <EditForm Model="condition" OnValidSubmit="SaveCondition">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="name" class="form-label">Name</label>
                <InputText id="name" class="form-input" @bind-Value="condition.Name" />
                <ValidationMessage For="@(() => condition.Name)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">💾 Save</button>
                <button class="btn btn-cancel" @onclick="Cancel">↩️ Cancel</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private List<ConditionDto> conditions = new();
    private ConditionDto condition = new ConditionDto();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/other");
    }

    protected override async Task OnInitializedAsync()
    {
        conditions = (await ConditionService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddCondition()
    {
        condition = new ConditionDto();
        isAdding = true;
        isEditing = false;
    }

    private async Task EditCondition(int id)
    {
        condition = await ConditionService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SaveCondition()
    {
        if (isEditing)
        {
            await ConditionService.UpdateAsync(condition.Id, condition);
        }
        else if (isAdding)
        {
            await ConditionService.AddAsync(condition);
        }

        conditions = (await ConditionService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }

    private async Task DeleteCondition(int id)
    {
        await ConditionService.DeleteAsync(id);
        conditions = (await ConditionService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }
}

