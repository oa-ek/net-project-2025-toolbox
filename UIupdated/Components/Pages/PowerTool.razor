@page "/powertools"
@using Core.DTOs
@using UIinterface.Services
@inject PowerToolService PowerToolService
@inject ToolTypeService ToolTypeService
@inject ConditionService ConditionService
@inject ToolModelService ToolModelService
@inject PowerSupplyTypeService PowerSupplyTypeService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Boss")]



<PageTitle>Power Tools</PageTitle>

<div class="page-container">
    <h3 class="title">Power Tools</h3>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Tool Type</th>
                    <th>Condition</th>
                    <th>Tool Model</th>
                    <th>Power Supply</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tool in powerTools)
                {
                    <tr>
                        <td>@toolTypes.FirstOrDefault(t => t.Id == tool.ToolTypeId)?.Name</td>
                        <td>@conditions.FirstOrDefault(c => c.Id == tool.ConditionId)?.Name</td>
                        <td>@toolModels.FirstOrDefault(m => m.Id == tool.ToolModelId)?.Name</td>
                        <td>@powerSupplyTypes.FirstOrDefault(p => p.Id == tool.PowerSupplyTypeId)?.Name</td>
                        <td>@tool.Price</td>
                        <td>
                            <button class="btn btn-edit" @onclick="() => EditPowerTool(tool.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeletePowerTool(tool.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-add" @onclick="AddPowerTool">➕ Add Power Tool</button>
        <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
        @code {
        private void GoBack()
        {
            Navigation.NavigateTo("/admin/tools");
        }
    }
    }
</div>

@code {
    private List<PowerToolDto> powerTools = new();
    private List<ToolTypeDto> toolTypes = new();
    private List<ConditionDto> conditions = new();
    private List<ToolModelDto> toolModels = new();
    private List<PowerSupplyTypeDto> powerSupplyTypes = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        powerTools = (await PowerToolService.GetAllAsync()).ToList();
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
        conditions = (await ConditionService.GetAllAsync()).ToList();
        toolModels = (await ToolModelService.GetAllAsync()).ToList();
        powerSupplyTypes = (await PowerSupplyTypeService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddPowerTool() => Navigation.NavigateTo("/powertools/addedit");

    private void EditPowerTool(int id) => Navigation.NavigateTo($"/powertools/addedit/{id}");

    private async Task DeletePowerTool(int id)
    {
        await PowerToolService.DeleteAsync(id);
        powerTools = (await PowerToolService.GetAllAsync()).ToList();
    }
}
