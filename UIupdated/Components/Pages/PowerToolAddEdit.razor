@page "/powertools/addedit/{Id:int?}"
@using Core.DTOs
@using UIinterface.Services
@inject PowerToolService PowerToolService
@inject ToolTypeService ToolTypeService
@inject ConditionService ConditionService
@inject ToolModelService ToolModelService
@inject PowerSupplyTypeService PowerSupplyTypeService
@inject WorkerService WorkerService
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Boss")]



<PageTitle>Add/Edit Power Tool</PageTitle>

<div class="page-container">
    <h3 class="title">@((isEditing ? "Edit" : "Add") + " Power Tool")</h3>

    <EditForm Model="powerTool" OnValidSubmit="SavePowerTool">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @* Tool Type *@
        <div class="form-group">
            <label>Tool Type</label>
            <InputSelect class="form-control" @bind-Value="powerTool.ToolTypeId">
                <option value="">Select tool type</option>
                @foreach (var item in toolTypes)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => powerTool.ToolTypeId)" />
        </div>

        @* Condition *@
        <div class="form-group">
            <label>Condition</label>
            <InputSelect class="form-control" @bind-Value="powerTool.ConditionId">
                <option value="">Select condition</option>
                @foreach (var item in conditions)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => powerTool.ConditionId)" />
        </div>

        @* Tool Model *@
        <div class="form-group">
            <label>Tool Model</label>
            <InputSelect class="form-control" @bind-Value="powerTool.ToolModelId">
                <option value="">Select model</option>
                @foreach (var item in toolModels)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => powerTool.ToolModelId)" />
        </div>

        @* Power Supply Type *@
        <div class="form-group">
            <label>Power Supply</label>
            <InputSelect class="form-control" @bind-Value="powerTool.PowerSupplyTypeId">
                <option value="">Select type</option>
                @foreach (var item in powerSupplyTypes)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => powerTool.PowerSupplyTypeId)" />
        </div>

        @* Last Worker *@
        <div class="form-group">
            <label>Last Worker</label>
            <InputSelect class="form-control" @bind-Value="powerTool.LastWorkerId">
                <option value="">Select worker</option>
                @foreach (var item in workers)
                {
                    <option value="@item.Id">@item.FirstName @item.LastName</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => powerTool.LastWorkerId)" />
        </div>

        @* Last Location *@
        <div class="form-group">
            <label>Last Location</label>
            <InputSelect class="form-control" @bind-Value="powerTool.LastLocationId">
                <option value="">Select location</option>
                @foreach (var item in locations)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => powerTool.LastLocationId)" />
        </div>

        @* Has Case *@
        <div class="form-group">
            <label>Has Case</label><br />
            <InputCheckbox class="form-check-input" @bind-Value="powerTool.HasCase" />
            <ValidationMessage For="@(() => powerTool.HasCase)" />
        </div>

        @* Date Made *@
        <div class="form-group">
            <label>Date Made</label>
            <InputDate class="form-control" @bind-Value="powerTool.DateMade" />
            <ValidationMessage For="@(() => powerTool.DateMade)" />
        </div>

        @* Serial Number *@
        <div class="form-group">
            <label>Serial Number</label>
            <InputText class="form-control" @bind-Value="powerTool.SerialNumber" />
            <ValidationMessage For="@(() => powerTool.SerialNumber)" />
        </div>

        @* Number *@
        <div class="form-group">
            <label>Number</label>
            <InputText class="form-control" @bind-Value="powerTool.Number" />
            <ValidationMessage For="@(() => powerTool.Number)" />
        </div>

        @* Price *@
        <div class="form-group">
            <label>Price</label>
            <InputNumber class="form-control" @bind-Value="powerTool.Price" />
            <ValidationMessage For="@(() => powerTool.Price)" />
        </div>

        @* Error Message *@
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-save">💾 Save</button>
            <button type="button" class="btn btn-cancel" @onclick="Cancel">↩️ Cancel</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private PowerToolDto powerTool = new();
    private List<ToolTypeDto> toolTypes = new();
    private List<ConditionDto> conditions = new();
    private List<ToolModelDto> toolModels = new();
    private List<PowerSupplyTypeDto> powerSupplyTypes = new();
    private List<WorkerDto> workers = new();
    private List<LocationDto> locations = new();
    private bool isEditing = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
        conditions = (await ConditionService.GetAllAsync()).ToList();
        toolModels = (await ToolModelService.GetAllAsync()).ToList();
        powerSupplyTypes = (await PowerSupplyTypeService.GetAllAsync()).ToList();
        workers = (await WorkerService.GetAllAsync()).ToList();
        locations = (await LocationService.GetAllAsync()).ToList();

        if (Id.HasValue)
        {
            powerTool = await PowerToolService.GetByIdAsync(Id.Value);
            isEditing = true;
        }
    }

    private async Task SavePowerTool()
    {
        if (!ValidatePowerTool())
        {
            errorMessage = "All required fields must be filled.";
            return;
        }

        try
        {
            if (isEditing)
                await PowerToolService.UpdateAsync(powerTool.Id, powerTool);
            else
                await PowerToolService.AddAsync(powerTool);

            Navigation.NavigateTo("/powertools");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }

    private bool ValidatePowerTool() =>
        powerTool.ToolTypeId > 0 && powerTool.ConditionId > 0 &&
        powerTool.ToolModelId > 0 && powerTool.PowerSupplyTypeId > 0 &&
        powerTool.LastWorkerId > 0 && powerTool.LastLocationId > 0 &&
        !string.IsNullOrWhiteSpace(powerTool.SerialNumber) &&
        !string.IsNullOrWhiteSpace(powerTool.Number);

    private void Cancel() => Navigation.NavigateTo("/powertools");
}
