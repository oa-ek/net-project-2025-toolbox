@page "/systemadmins"
@using Core.DTOs
@using UIinterface.Services
@inject SystemAdminService SystemAdminService
@inject BossService BossService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>System Admins</PageTitle>

<div class="page-container">
    <h3 class="title">System Admins</h3>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in systemAdmins)
                {
                    <tr>
                        <td>@admin.FirstName</td>
                        <td>@admin.LastName</td>
                        <td>@admin.Email</td>
                        <td>@admin.Phone</td>
                        <td>
                            <button class="btn btn-save" @onclick="() => EditSystemAdmin(admin.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeleteSystemAdmin(admin.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button class="btn btn-save" @onclick="AddSystemAdmin">➕ Add New System Admin</button>
            <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
            @code {
            private void GoBack()
            {
                Navigation.NavigateTo("/admin/people");
            }
        }
        </div>
    }

    @if (isEditing || isAdding)
    {
        <EditForm Model="systemAdmin" OnValidSubmit="SaveSystemAdmin" class="form-container">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="firstName">First Name</label>
                <InputText id="firstName" @bind-Value="systemAdmin.FirstName" class="form-control" />
            </div>
            <div class="form-group">
                <label for="lastName">Last Name</label>
                <InputText id="lastName" @bind-Value="systemAdmin.LastName" class="form-control" />
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email" @bind-Value="systemAdmin.Email" class="form-control" />
            </div>
            <div class="form-group">
                <label for="phone">Phone</label>
                <InputText id="phone" @bind-Value="systemAdmin.Phone" class="form-control" />
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" @bind-Value="systemAdmin.Password" class="form-control" />
            </div>
            <div class="form-group">
                <label for="bossId">Boss</label>
                <InputSelect id="bossId" @bind-Value="systemAdmin.BossId" class="form-control">
                    <option value="">Select a boss</option>
                    @foreach (var boss in bosses)
                    {
                        <option value="@boss.Id">@boss.FirstName @boss.LastName</option>
                    }
                </InputSelect>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">💾 Save</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private List<SystemAdminDto> systemAdmins = new();
    private SystemAdminDto systemAdmin = new();
    private List<BossDto> bosses = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

    protected override async Task OnInitializedAsync()
    {
        systemAdmins = (await SystemAdminService.GetAllAsync()).ToList();
        bosses = (await BossService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddSystemAdmin()
    {
        systemAdmin = new SystemAdminDto();
        isAdding = true;
        isEditing = false;
    }

    private async Task EditSystemAdmin(int id)
    {
        systemAdmin = await SystemAdminService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SaveSystemAdmin()
    {
        if (isEditing)
        {
            await SystemAdminService.UpdateAsync(systemAdmin.Id, systemAdmin);
        }
        else if (isAdding)
        {
            await SystemAdminService.AddAsync(systemAdmin);
        }

        systemAdmins = (await SystemAdminService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }

    private async Task DeleteSystemAdmin(int id)
    {
        await SystemAdminService.DeleteAsync(id);
        systemAdmins = (await SystemAdminService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }
}
