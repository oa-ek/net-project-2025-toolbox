@page "/systemadmins"
@using Core.DTOs
@using UIinterface.Services
@inject SystemAdminService SystemAdminService
@inject BossService BossService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>System Admins</PageTitle>

<h3>System Admins</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var admin in systemAdmins)
            {
                <tr>
                    <td>@admin.FirstName</td>
                    <td>@admin.LastName</td>
                    <td>@admin.Email</td>
                    <td>@admin.Phone</td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditSystemAdmin(admin.Id)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => DeleteSystemAdmin(admin.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary" @onclick="AddSystemAdmin">Add New System Admin</button>
}

@if (isEditing || isAdding)
{
    <EditForm Model="systemAdmin" OnValidSubmit="SaveSystemAdmin">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="firstName" class="form-label">First Name</label>
            <InputText id="firstName" class="form-control" @bind-Value="systemAdmin.FirstName" />
        </div>
        <div class="mb-3">
            <label for="lastName" class="form-label">Last Name</label>
            <InputText id="lastName" class="form-control" @bind-Value="systemAdmin.LastName" />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-control" @bind-Value="systemAdmin.Email" />
        </div>
        <div class="mb-3">
            <label for="phone" class="form-label">Phone</label>
            <InputText id="phone" class="form-control" @bind-Value="systemAdmin.Phone" />
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <InputText id="password" class="form-control" @bind-Value="systemAdmin.Password" />
        </div>
        <div class="mb-3">
            <label for="bossId" class="form-label">Boss</label>
            <InputSelect id="bossId" class="form-control" @bind-Value="systemAdmin.BossId">
                <option value="">Select a boss</option>
                @foreach (var boss in bosses)
                {
                    <option value="@boss.Id">@boss.FirstName @boss.LastName</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    private List<SystemAdminDto> systemAdmins = new();
    private SystemAdminDto systemAdmin = new SystemAdminDto();
    private List<BossDto> bosses = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

    protected override async Task OnInitializedAsync()
    {
        systemAdmins = (await SystemAdminService.GetAllAsync()).ToList();
        bosses = (await BossService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddSystemAdmin()
    {
        systemAdmin = new SystemAdminDto();
        isAdding = true;
        isEditing = false;
    }

    private async Task EditSystemAdmin(int id)
    {
        systemAdmin = await SystemAdminService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SaveSystemAdmin()
    {
        if (isEditing)
        {
            await SystemAdminService.UpdateAsync(systemAdmin.Id, systemAdmin);
        }
        else if (isAdding)
        {
            await SystemAdminService.AddAsync(systemAdmin);
        }

        systemAdmins = (await SystemAdminService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }

    private async Task DeleteSystemAdmin(int id)
    {
        await SystemAdminService.DeleteAsync(id);
        systemAdmins = (await SystemAdminService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }
}
