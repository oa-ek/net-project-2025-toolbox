@page "/powersupplytypes"
@using Core.DTOs
@using UIinterface.Services
@inject PowerSupplyTypeService PowerSupplyTypeService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Power Supply Types</PageTitle>

<div class="page-container">
    <h3 class="title">Power Supply Types</h3>

    @if (isLoading)
    {
        <p class="loading-text">Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th class="table-header">Name</th>
                    <th class="table-header">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in powerSupplyTypeList)
                {
                    <tr>
                        <td class="table-cell">@item.Name</td>
                        <td class="table-cell">
                            <button class="btn btn-edit" @onclick="() => EditItem(item.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeleteItem(item.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-add" @onclick="AddItem">➕ Add New</button>
        <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
        @code {
        private void GoBack()
        {
            Navigation.NavigateTo("/admin/people");
        }
    }
    }

    @if (isEditing || isAdding)
    {
        <EditForm Model="currentItem" OnValidSubmit="SaveItem">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="name" class="form-label">Type Name</label>
                <InputText id="name" class="form-input" @bind-Value="currentItem.Name" />
                <ValidationMessage For="@(() => currentItem.Name)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">💾 Save</button>
                <button type="button" class="btn btn-cancel" @onclick="Cancel">↩️ Cancel</button>
            </div>
        </EditForm>
    }
</div>


@code {
    private List<PowerSupplyTypeDto> powerSupplyTypeList = new();
    private PowerSupplyTypeDto currentItem = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

    protected override async Task OnInitializedAsync()
    {
        powerSupplyTypeList = (await PowerSupplyTypeService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddItem()
    {
        currentItem = new PowerSupplyTypeDto();
        isAdding = true;
        isEditing = false;
    }

    private async Task EditItem(int id)
    {
        currentItem = await PowerSupplyTypeService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SaveItem()
    {
        if (isEditing)
        {
            await PowerSupplyTypeService.UpdateAsync(currentItem.Id, currentItem);
        }
        else if (isAdding)
        {
            await PowerSupplyTypeService.AddAsync(currentItem);
        }

        powerSupplyTypeList = (await PowerSupplyTypeService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }

    private async Task DeleteItem(int id)
    {
        await PowerSupplyTypeService.DeleteAsync(id);
        powerSupplyTypeList = (await PowerSupplyTypeService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }
}
