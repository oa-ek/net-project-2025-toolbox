@page "/add-edit-worker/{WorkerId:int?}"
@using Core.DTOs
@using UIinterface.Services
@using UIupdated.Services
@inject WorkerService WorkerService
@inject PositionService PositionService
@inject BossService BossService
@inject LocationService LocationService
@inject NavigationManager Navigation
@inject IUserService UserService
@inject IJSRuntime JSRuntime
@inject SystemAdminService SystemAdminService

@rendermode InteractiveServer

<PageTitle>Add/Edit Worker</PageTitle>

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Boss")]


<div class="page-container">
    <h3 class="title">@(isEditing ? "Edit Worker" : "Add Worker")</h3>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <EditForm Model="worker" OnValidSubmit="SaveWorker">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-columns">
                <div class="form-column">
                    <div class="form-group">
                        <label for="firstName" class="form-label">First Name</label>
                        <InputText id="firstName" class="form-input" @bind-Value="worker.FirstName" />
                        <ValidationMessage For="@(() => worker.FirstName)" />
                    </div>
                    <div class="form-group">
                        <label for="lastName" class="form-label">Last Name</label>
                        <InputText id="lastName" class="form-input" @bind-Value="worker.LastName" />
                        <ValidationMessage For="@(() => worker.LastName)" />
                    </div>
                    <div class="form-group">
                        <label for="userEmail" class="form-label">User Email</label>
                        <InputSelect id="userEmail" class="form-input" @bind-Value="worker.Email">
                            <option value="">Select user email</option>
                            @foreach (var user in users)
                            {
                                <option value="@user.Email">@user.Email</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => worker.Email)" />
                    </div>
                    <div class="form-group">
                        <label for="phone" class="form-label">Phone</label>
                        <InputText id="phone" class="form-input" @bind-Value="worker.Phone" />
                        <ValidationMessage For="@(() => worker.Phone)" />
                    </div>
                    <div class="form-group">
                        <label for="password" class="form-label">Password</label>
                        <InputText id="password" class="form-input" @bind-Value="worker.Password" type="password" />
                        <ValidationMessage For="@(() => worker.Password)" />
                    </div>
                </div>

                <div class="form-column">
                    <div class="form-group">
                        <label for="locationId" class="form-label">Location</label>
                        <InputSelect id="locationId" class="form-input" @bind-Value="worker.LocationId">
                            <option value="">Select a location</option>
                            @foreach (var location in locations)
                            {
                                <option value="@location.Id">@location.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => worker.LocationId)" />
                    </div>
                    <div class="form-group">
                        <label for="positionId" class="form-label">Position</label>
                        <InputSelect id="positionId" class="form-input" @bind-Value="worker.PositionId">
                            <option value="">Select a position</option>
                            @foreach (var position in positions)
                            {
                                <option value="@position.Id">@position.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => worker.PositionId)" />
                    </div>
                    <div class="form-group">
                        <label for="bossId" class="form-label">Boss</label>
                        <InputSelect id="bossId" class="form-input" @bind-Value="worker.BossId">
                            <option value="">Select a boss</option>
                            @foreach (var boss in bosses)
                            {
                                <option value="@boss.Id">@boss.FirstName @boss.LastName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => worker.BossId)" />
                    </div>
 @* <!--                  <div class="form-group">
                        <label for="latitute" class="form-label">Latitude</label>
                        <InputNumber id="latitute" class="form-input" @bind-Value="worker.Latitute" />
                        <ValidationMessage For="@(() => worker.Latitute)" />
                    </div>
                    <div class="form-group">
                        <label for="longitute" class="form-label">Longitude</label>
                        <InputNumber id="longitute" class="form-input" @bind-Value="worker.Longitute" />
                        <ValidationMessage For="@(() => worker.Longitute)" />
                    </div>
                                      -->*@
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">💾 Save</button>
                @if (isEditing)
                {
                    <button class="btn btn-delete" @onclick="DeleteWorker">🗑️ Delete</button>
                }
                <button class="btn btn-cancel" @onclick="Cancel">↩️ Cancel</button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int? WorkerId { get; set; }
    private WorkerDto worker = new WorkerDto();
    private List<LocationDto> locations = new();
    private List<PositionDto> positions = new();
    private List<BossDto> bosses = new();
    private List<UserDto> users = new();
    private bool isLoading = true;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        locations = (await LocationService.GetAllAsync()).ToList();
        positions = (await PositionService.GetAllAsync()).ToList();
        bosses = (await BossService.GetAllAsync()).ToList();
        users = (await UserService.GetAllUsersAsync()).ToList();

        var workers = await WorkerService.GetAllAsync();
        var systemAdmins = await SystemAdminService.GetAllAsync();
        var allBosses = await BossService.GetAllAsync();

        // Збираємо всі зайняті email-и
        var occupiedEmails = new HashSet<string>(
            workers.Select(w => w.Email)
            .Concat(systemAdmins.Select(a => a.Email))
            .Concat(allBosses.Select(b => b.Email)),
            StringComparer.OrdinalIgnoreCase
        );

        // Відображаємо лише вільні email-и
        users = users
    .Where(u => u.Roles == null || u.Roles.Count == 0)
    .ToList();



        if (WorkerId.HasValue)
        {
            worker = await WorkerService.GetByIdAsync(WorkerId.Value);
            isEditing = true;

            // Додаємо email редагованого користувача назад у список, щоб не зник при редагуванні
            if (!string.IsNullOrWhiteSpace(worker.Email) &&
                !users.Any(u => u.Email == worker.Email))
            {
                var currentUser = await UserService.GetUserByEmailAsync(worker.Email);
                if (currentUser is not null)
                    users.Add(currentUser);
            }
        }

        isLoading = false;
    }


    private async Task SaveWorker()
    {
        if (!string.IsNullOrWhiteSpace(worker.Email))
        {
            var user = await UserService.GetUserByEmailAsync(worker.Email);
            if (user is not null)
            {
                var roleAssigned = await UserService.AssignRoleAsync(user.Id, "Worker");
                if (!roleAssigned)
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"❌ Не вдалося призначити роль Worker користувачу {user.Email}");
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"✅ Користувачу призначено роль Worker. ID: {user.Id}");
                }
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"❌ Користувача з email {worker.Email} не знайдено");
            }
        }

        if (isEditing)
        {
            await WorkerService.UpdateAsync(worker.Id, worker);
        }
        else
        {
            await WorkerService.AddAsync(worker);
        }

        Navigation.NavigateTo("/workers");
    }

    private async Task DeleteWorker()
    {
        var user = await UserService.GetUserByEmailAsync(worker.Email);
        if (user != null)
        {
          //  await JSRuntime.InvokeVoidAsync("alert", $"User ID: {user.Id}");

            var workerRole = await UserService.GetRoleByNameAsync("Worker");
            if (workerRole != null)
            {
               // await JSRuntime.InvokeVoidAsync("alert", $"Role ID: {workerRole.Id}");

                var removed = await UserService.RemoveRoleByIdAsync(user.Id, workerRole.Id);
                if (removed)
                {
                  //  await JSRuntime.InvokeVoidAsync("alert", $"User with ID {user.Id} had role {workerRole.Id} removed.");
                }
                else
                {
                  //  await JSRuntime.InvokeVoidAsync("alert", $"Failed to remove role {workerRole.Id} from user {user.Id}.");
                }
            }
            else
            {
              //  await JSRuntime.InvokeVoidAsync("alert", $"Role 'Worker' not found.");
            }
        }
        else
        {
           // await JSRuntime.InvokeVoidAsync("alert", $"User with email {worker.Email} not found.");
        }

        await WorkerService.DeleteAsync(worker.Id);
        Navigation.NavigateTo("/workers");
    }




    private void Cancel()
    {
        Navigation.NavigateTo("/workers");
    }
}

