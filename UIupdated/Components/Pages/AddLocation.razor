@page "/add-location"
@using Core.DTOs
@using UIinterface.Services
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Add Location</PageTitle>

<h3>Add New Location</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="location" OnValidSubmit="SaveLocation">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="name">Name</label>
            <InputText id="name" @bind-Value="location.Name" class="form-control" />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <InputText id="description" @bind-Value="location.Description" class="form-control" />
        </div>

        <div class="form-group">
            <label>Location</label>
            <MapComponent Location="location" OnLocationChanged="HandleLocationChanged" />
        </div>

        <button class="btn btn-primary" type="submit">Add</button>
        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    private LocationDto location = new LocationDto
        {
            Latitute = 50.327925, // Default latitude
            Longitute = 26.5119475 // Default longitude
        };
    private bool isLoading = false;

    private async Task SaveLocation()
    {
        await LocationService.AddAsync(location);
        Navigation.NavigateTo("/locations", forceLoad: true);
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/locations");
    }

    private void HandleLocationChanged(LocationDto updatedLocation)
    {
        location.Latitute = updatedLocation.Latitute;
        location.Longitute = updatedLocation.Longitute;
    }
}
