@page "/locations/{locationId:int}/workers"
@using Core.DTOs
@using UIinterface.Services
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Boss")]



<PageTitle>Location Details</PageTitle>

<div class="page-container">
    @if (location == null)
    {
        <p class="loading-text">Loading...</p>
    }
    else
    {
        <h3 class="title">Location: @location.Name</h3>
        <p>@location.Description</p>

        <h4>Bosses:</h4>
        <table class="styled-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var boss in location.Bosses)
                {
                    <tr>
                        <td>@boss.Id</td>
                        <td>@boss.FirstName</td>
                        <td>@boss.LastName</td>
                        <td>@boss.Email</td>
                        <td>@boss.Phone</td>
                    </tr>
                }
            </tbody>
        </table>

        <h4>Workers:</h4>
        <table class="styled-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var worker in location.Workers)
                {
                    <tr>
                        <td>@worker.Id</td>
                        <td>@worker.FirstName</td>
                        <td>@worker.LastName</td>
                        <td>@worker.Email</td>
                        <td>@worker.Phone</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public int LocationId { get; set; }

    private LocationDto location;

    protected override async Task OnInitializedAsync()
    {
        location = await LocationService.GetByIdAsync(LocationId);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/locations");
    }
}
