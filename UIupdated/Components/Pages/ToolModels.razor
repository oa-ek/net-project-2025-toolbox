@page "/toolmodels"
@using Core.DTOs
@using UIinterface.Services
@inject ToolModelService ToolModelService
@inject BrandService BrandService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Tool Models</PageTitle>

<h3>Tool Models</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Brand</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var toolModel in toolModels)
            {
                <tr>
                    <td>@toolModel.Name</td>
                    <td>@brands.FirstOrDefault(b => b.Id == toolModel.BrandId)?.Name</td>
                    <td>
                        <button class="btn btn-primary" @onclick="() => EditToolModel(toolModel.Id)">Edit</button>
                        <button class="btn btn-danger" @onclick="() => DeleteToolModel(toolModel.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-primary" @onclick="AddToolModel">Add New Tool Model</button>
}

@if (isEditing || isAdding)
{
    <EditForm Model="toolModel" OnValidSubmit="SaveToolModel">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="toolModel.Name" />
            <ValidationMessage For="@(() => toolModel.Name)" />
        </div>
        <div class="mb-3">
            <label for="brandId" class="form-label">Brand</label>
            <InputSelect id="brandId" class="form-control" @bind-Value="toolModel.BrandId">
                <option value="">Select a brand</option>
                @foreach (var brand in brands)
                {
                    <option value="@brand.Id">@brand.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => toolModel.BrandId)" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    private List<ToolModelDto> toolModels = new();
    private ToolModelDto toolModel = new ToolModelDto();
    private List<BrandDto> brands = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

    protected override async Task OnInitializedAsync()
    {
        toolModels = (await ToolModelService.GetAllAsync()).ToList();
        brands = (await BrandService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddToolModel()
    {
        toolModel = new ToolModelDto();
        isAdding = true;
        isEditing = false;
    }

    private async Task EditToolModel(int id)
    {
        toolModel = await ToolModelService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SaveToolModel()
    {
        if (isEditing)
        {
            await ToolModelService.UpdateAsync(toolModel.Id, toolModel);
        }
        else if (isAdding)
        {
            await ToolModelService.AddAsync(toolModel);
        }

        toolModels = (await ToolModelService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }

    private async Task DeleteToolModel(int id)
    {
        await ToolModelService.DeleteAsync(id);
        toolModels = (await ToolModelService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }
}
