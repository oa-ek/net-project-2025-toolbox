@page "/tools-management"
@using Core.DTOs
@using UIinterface.Services
@inject PowerToolService PowerToolService
@inject HandToolService HandToolService
@inject BataryService BataryService
@inject WorkerService WorkerService
@inject LocationService LocationService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3>Tool Management</h3>

<!-- Вибір типу інструменту -->
<div class="mb-3">
    <label for="toolTypeSelect">Select Tool Type:</label>
    <select id="toolTypeSelect" class="form-select" @onchange="OnToolTypeChanged">
        <option value="PowerTool">Power Tool</option>
        <option value="HandTool">Hand Tool</option>
        <option value="Batary">Batary</option>
    </select>
</div>

<!-- Пошук -->
<div class="mb-3">
    <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search tools..." class="form-control" />
</div>

<!-- Таблиця інструментів -->
<table class="table">
    <thead>
        <tr>
            <th>
                <input type="checkbox" @onclick="ToggleSelectAll" />
            </th>
            <th>Name</th>
            <th>Serial Number</th>
            <th>Condition</th>
        </tr>
    </thead>
    <tbody>
        @if (selectedToolType == "PowerTool")
        {
            @foreach (var tool in filteredPowerTools)
            {
                <tr>
                    <td>
                        <input type="checkbox" @bind="tool.IsSelected" />
                    </td>
                    <td>@tool.ToolTypeName</td>
                    <td>@tool.SerialNumber</td>
                    <td>@tool.ConditionName</td>
                </tr>
            }
        }
        else if (selectedToolType == "HandTool")
        {
            @foreach (var tool in filteredHandTools)
            {
                <tr>
                    <td>
                        <input type="checkbox" @bind="tool.IsSelected" />
                    </td>
                    <td>@tool.Name</td>
                    <td>N/A</td>
                    <td>N/A</td>
                </tr>
            }
        }
        else if (selectedToolType == "Batary")
        {
            @foreach (var tool in filteredBataries)
            {
                <tr>
                    <td>
                        <input type="checkbox" @bind="tool.IsSelected" />
                    </td>
                    <td>@tool.BataryModelName</td>
                    <td>@tool.SerialNumber</td>
                    <td>@tool.ConditionName</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="4">Loading...</td></tr>
        }
    </tbody>
</table>

<!-- Кнопка призначення інструментів -->
<div class="mt-3">
    <button class="btn btn-primary" @onclick="OpenAssignModal">Assign Selected Tools</button>
</div>

<!-- Кнопка підтвердження локації (з'являється після підтвердження інструментів) -->
@if (isLocationConfirmButtonVisible)
{
    <div class="mt-3">
        <button class="btn btn-success" @onclick="GoToLocationsMap">Підтвердити локацію</button>
    </div>
}

<!-- Модальне вікно для підтвердження призначення інструментів -->
@if (isAssignModalOpen)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Підтвердження отримання інструментів</h5>
                    <button type="button" class="btn-close" @onclick="CloseAssignModal"></button>
                </div>
                <div class="modal-body">
                    @if (currentWorker != null)
                    {
                        <p>
                            Ви, <b>@currentWorker.FirstName @currentWorker.LastName</b> (<b>@currentWorker.Email</b>), справді хочете взяти ці інструменти:
                        </p>
                        <ul>
                            @foreach (var tool in GetAllSelectedTools())
                            {
                                <li>@tool.Type: @tool.Name</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-danger">Не вдалося знайти ваш профіль працівника. Зверніться до адміністратора.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAssignModal">Скасувати</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmAssignment" disabled="@(currentWorker == null)">Так</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Модальне вікно для вибору локації -->
@if (isLocationModalOpen)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Location</h5>
                    <button type="button" class="btn-close" @onclick="CloseLocationModal"></button>
                </div>
                <div class="modal-body">
                    <p>Search for a location:</p>
                    <input type="text" @bind="locationSearchTerm" class="form-control" placeholder="Search Location" />
                    <ul class="list-group mt-3">
                        @foreach (var location in locations)
                        {
                            <li class="list-group-item @(selectedLocationId == location.Id ? "active" : "")"
                                @onclick="() => SelectLocation(location.Id)">
                                <strong>@location.Name</strong> - @location.Description
                            </li>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseLocationModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmLocation" disabled="@(selectedLocationId == 0)">Підтвердити локацію</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string selectedToolType = "PowerTool";
    private List<PowerToolDto> allPowerTools = new();
    private List<HandToolDto> allHandTools = new();
    private List<BataryDto> allBataries = new();

    private List<PowerToolDto> filteredPowerTools = new();
    private List<HandToolDto> filteredHandTools = new();
    private List<BataryDto> filteredBataries = new();

    private List<LocationDto> locations;
    private string searchTerm = string.Empty;
    private string locationSearchTerm = string.Empty;
    private bool isAssignModalOpen = false;
    private bool isLocationModalOpen = false;
    private int selectedLocationId;
    private bool isLocationConfirmButtonVisible = false;

    private WorkerDto currentWorker;

    protected override async Task OnInitializedAsync()
    {
        await LoadCurrentWorkerAsync();
        await LoadAllToolsAsync();
        await LoadLocationsAsync();
        FilterTools();
    }

    private async Task LoadCurrentWorkerAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var email = user.Identity?.Name;

        if (!string.IsNullOrEmpty(email))
        {
            currentWorker = await WorkerService.GetWorkerByEmailAsync(email);
        }
    }

    private async Task LoadAllToolsAsync()
    {
        allPowerTools = (await PowerToolService.GetAllAsync()).ToList();
        allHandTools = (await HandToolService.GetAllAsync()).ToList();
        allBataries = (await BataryService.GetAllAsync()).ToList();
    }

    private async Task LoadLocationsAsync()
    {
        locations = (await LocationService.GetAllAsync()).ToList();
    }

    private void OnToolTypeChanged(ChangeEventArgs e)
    {
        selectedToolType = e.Value?.ToString();
        FilterTools();
    }

    private void FilterTools()
    {
        if (selectedToolType == "PowerTool")
        {
            filteredPowerTools = string.IsNullOrWhiteSpace(searchTerm)
                ? allPowerTools
                : allPowerTools.Where(t =>
                    (t.ToolTypeName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (t.SerialNumber ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (t.ConditionName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                ).ToList();
        }
        else if (selectedToolType == "HandTool")
        {
            filteredHandTools = string.IsNullOrWhiteSpace(searchTerm)
                ? allHandTools
                : allHandTools.Where(t =>
                    (t.Name ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                ).ToList();
        }
        else if (selectedToolType == "Batary")
        {
            filteredBataries = string.IsNullOrWhiteSpace(searchTerm)
                ? allBataries
                : allBataries.Where(b =>
                    (b.BataryModelName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (b.SerialNumber ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (b.ConditionName ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                ).ToList();
        }
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (selectedToolType == "PowerTool")
        {
            var selectAll = filteredPowerTools.All(t => t.IsSelected);
            foreach (var tool in filteredPowerTools)
            {
                tool.IsSelected = !selectAll;
            }
        }
        else if (selectedToolType == "HandTool")
        {
            var selectAll = filteredHandTools.All(t => t.IsSelected);
            foreach (var tool in filteredHandTools)
            {
                tool.IsSelected = !selectAll;
            }
        }
        else if (selectedToolType == "Batary")
        {
            var selectAll = filteredBataries.All(t => t.IsSelected);
            foreach (var tool in filteredBataries)
            {
                tool.IsSelected = !selectAll;
            }
        }
    }

    private void OpenAssignModal()
    {
        isAssignModalOpen = true;
    }

    private void CloseAssignModal()
    {
        isAssignModalOpen = false;
    }

    private async Task ConfirmAssignment()
    {
        var selectedPowerToolIds = filteredPowerTools?.Where(t => t.IsSelected).Select(t => t.Id).ToList() ?? new List<int>();
        var selectedHandToolIds = filteredHandTools?.Where(t => t.IsSelected).Select(t => t.Id).ToList() ?? new List<int>();
        var selectedBataryIds = filteredBataries?.Where(t => t.IsSelected).Select(t => t.Id).ToList() ?? new List<int>();

        if (currentWorker != null && (selectedPowerToolIds.Any() || selectedHandToolIds.Any() || selectedBataryIds.Any()))
        {
            if (selectedPowerToolIds.Any())
                await WorkerService.AssignToolsToWorkerAsync(currentWorker.Id, selectedPowerToolIds, "PowerTool", selectedLocationId);
            if (selectedHandToolIds.Any())
                await WorkerService.AssignToolsToWorkerAsync(currentWorker.Id, selectedHandToolIds, "HandTool", selectedLocationId);
            if (selectedBataryIds.Any())
                await WorkerService.AssignToolsToWorkerAsync(currentWorker.Id, selectedBataryIds, "Batary", selectedLocationId);

            CloseAssignModal();
            await LoadAllToolsAsync();
            FilterTools();
            isLocationConfirmButtonVisible = true;
            StateHasChanged();
        }
    }

    private void OpenLocationModal()
    {
        isLocationModalOpen = true;
    }

    private void CloseLocationModal()
    {
        isLocationModalOpen = false;
    }

    private async Task SelectLocation(int locationId)
    {
        var location = locations.FirstOrDefault(l => l.Id == locationId);
        if (location != null)
        {
            selectedLocationId = location.Id;
            CloseLocationModal();
        }
    }

    private void GoToLocationsMap()
    {
        Navigation.NavigateTo("/locations-map");
    }

    private IEnumerable<(string Type, int Id, string Name)> GetAllSelectedTools()
    {
        foreach (var t in filteredPowerTools?.Where(t => t.IsSelected) ?? Enumerable.Empty<PowerToolDto>())
            yield return ("PowerTool", t.Id, t.ToolTypeName);
        foreach (var t in filteredHandTools?.Where(t => t.IsSelected) ?? Enumerable.Empty<HandToolDto>())
            yield return ("HandTool", t.Id, t.Name);
        foreach (var t in filteredBataries?.Where(t => t.IsSelected) ?? Enumerable.Empty<BataryDto>())
            yield return ("Batary", t.Id, t.BataryModelName);
    }

    private void ConfirmLocation()
    {
        CloseLocationModal();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        FilterTools();
    }
}
