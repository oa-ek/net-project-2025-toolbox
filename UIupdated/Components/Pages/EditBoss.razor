@page "/edit-boss/{BossId:int}"
@using Core.DTOs
@using UIinterface.Services
@inject BossService BossService
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Edit Boss</PageTitle>

<div class="page-container">
    <h3 class="title">Edit Boss</h3>

    <EditForm Model="boss" OnValidSubmit="SaveBoss">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="firstName" class="form-label">First Name</label>
            <InputText id="firstName" class="form-input" @bind-Value="boss.FirstName" />
        </div>

        <div class="form-group">
            <label for="lastName" class="form-label">Last Name</label>
            <InputText id="lastName" class="form-input" @bind-Value="boss.LastName" />
        </div>

        <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" class="form-input" @bind-Value="boss.Email" />
        </div>

        <div class="form-group">
            <label for="phone" class="form-label">Phone</label>
            <InputText id="phone" class="form-input" @bind-Value="boss.Phone" />
        </div>

        <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <InputText id="password" class="form-input" @bind-Value="boss.Password" type="password" />
        </div>

        <div class="form-group">
            <label class="form-label">Locations</label>
            @foreach (var location in locations)
            {
                <div class="checkbox-group">
                    <InputCheckbox @bind-Value="location.IsSelected" />
                    <label>@location.Name</label>
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-save">💾 Save</button>
            <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public int BossId { get; set; }

    private BossDto boss = new();
    private List<LocationViewModel> locations = new();

    protected override async Task OnInitializedAsync()
    {
        boss = await BossService.GetByIdAsync(BossId);
        var allLocations = await LocationService.GetAllAsync();

        var selectedIds = boss.Locations?.Select(l => l.Id).ToHashSet() ?? new();

        locations = allLocations.Select(loc => new LocationViewModel
            {
                Id = loc.Id,
                Name = loc.Name,
                IsSelected = selectedIds.Contains(loc.Id)
            }).ToList();
    }

    private async Task SaveBoss()
    {
        // Оновлення списку локацій: лише Id, щоб уникнути дублювання трекінгу
        boss.Locations = locations
            .Where(l => l.IsSelected)
            .Select(l => new LocationDto { Id = l.Id })
            .ToList();

        await BossService.UpdateAsync(boss.Id, boss);
        Navigation.NavigateTo("/bosses");
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/bosses");
    }

    public class LocationViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public bool IsSelected { get; set; }
    }
}
