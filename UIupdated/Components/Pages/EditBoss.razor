@page "/edit-boss/{BossId:int}"
@using Core.DTOs
@using UIinterface.Services
@inject BossService BossService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Edit Boss</PageTitle>

<h3>Edit Boss</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="boss" OnValidSubmit="SaveBoss">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="firstName">First Name</label>
            <InputText id="firstName" @bind-Value="boss.FirstName" class="form-control" />
        </div>

        <div class="form-group">
            <label for="lastName">Last Name</label>
            <InputText id="lastName" @bind-Value="boss.LastName" class="form-control" />
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" @bind-Value="boss.Email" class="form-control" />
        </div>

        <div class="form-group">
            <label for="phone">Phone</label>
            <InputText id="phone" @bind-Value="boss.Phone" class="form-control" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" @bind-Value="boss.Password" class="form-control" type="password" />
        </div>

        <button class="btn btn-primary" type="submit">Save</button>
        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter] public int BossId { get; set; }
    private BossDto boss = new BossDto();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        boss = await BossService.GetByIdAsync(BossId);
        isLoading = false;
    }

    private async Task SaveBoss()
    {
        await BossService.UpdateAsync(BossId, boss);
        Navigation.NavigateTo("/bosses", forceLoad: true);
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/bosses");
    }
}
