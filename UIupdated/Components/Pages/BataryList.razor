@page "/bataries"
@using Core.DTOs
@using UIinterface.Services
@inject BataryService BataryService
@inject BataryModelService BataryModelService
@inject ConditionService ConditionService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Batteries</PageTitle>

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Boss")]



<div class="page-container">
    <h3 class="title">Batteries</h3>

    @if (isLoading)
    {
        <p class="loading-text">Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th class="table-header">Model</th>
                    <th class="table-header">Condition</th>
                    <th class="table-header">Serial Number</th>
                    <th class="table-header">Number</th>
                    <th class="table-header">Price</th>
                    <th class="table-header">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var batary in bataries)
                {
                    <tr>
                        <td class="table-cell">@bataryModels.FirstOrDefault(m => m.Id == batary.BataryModelId)?.Name</td>
                        <td class="table-cell">@conditions.FirstOrDefault(c => c.Id == batary.ConditionId)?.Name</td>
                        <td class="table-cell">@batary.SerialNumber</td>
                        <td class="table-cell">@batary.Number</td>
                        <td class="table-cell">@batary.Price</td>
                        <td class="table-cell">
                            <button class="btn btn-edit" @onclick="() => EditBatary(batary.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeleteBatary(batary.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-add" @onclick="AddBatary">➕ Add New Battery</button>
        <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
        @code {
        private void GoBack()
        {
            Navigation.NavigateTo("/admin/tools");
        }
    }
    }
</div>

@code {
    private List<BataryDto> bataries = new();
    private List<BataryModelDto> bataryModels = new();
    private List<ConditionDto> conditions = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        bataries = (await BataryService.GetAllAsync()).ToList();
        bataryModels = (await BataryModelService.GetAllAsync()).ToList();
        conditions = (await ConditionService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddBatary() => Navigation.NavigateTo("/bataries/addedit");
    private void EditBatary(int id) => Navigation.NavigateTo($"/bataries/addedit/{id}");
    private async Task DeleteBatary(int id)
    {
        await BataryService.DeleteAsync(id);
        bataries = (await BataryService.GetAllAsync()).ToList();
    }
}
