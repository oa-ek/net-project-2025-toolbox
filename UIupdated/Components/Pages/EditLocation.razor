@page "/edit-location/{LocationId:int?}"
@using Core.DTOs
@using UIinterface.Services
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(LocationId == 0 ? "Add Location" : "Edit Location")</PageTitle>

<h3>@(LocationId == 0 ? "Add New Location" : "Edit Location")</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="location" OnValidSubmit="SaveLocation">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="name">Name</label>
            <InputText id="name" @bind-Value="location.Name" class="form-control" />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <InputText id="description" @bind-Value="location.Description" class="form-control" />
        </div>

        <div class="form-group">
            <label>Location</label>
            <MapComponent Location="location" OnLocationChanged="HandleLocationChanged" />
        </div>

        <button class="btn btn-primary" type="submit">@buttonText</button>
        <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter] public int? LocationId { get; set; }
    private LocationDto location = new();
    private bool isLoading = true;
    private string buttonText = "Save";

    protected override async Task OnInitializedAsync()
    {
        if (LocationId.HasValue && LocationId != 0)
        {
            // Редагування існуючої локації
            var fetchedLocation = await LocationService.GetByIdAsync(LocationId.Value);
            if (fetchedLocation != null)
            {
                location = fetchedLocation;
                buttonText = "Update";
            }
        }
        else
        {
            // Додавання нової локації
            location = new LocationDto
                {
                    Latitute = 50.327925, // Default latitude
                    Longitute = 26.5119475 // Default longitude
                };
            buttonText = "Add";
        }
        isLoading = false;
    }

    private async Task SaveLocation()
    {
        if (LocationId.HasValue && LocationId != 0)
        {
            // Оновлення існуючої локації
            await LocationService.UpdateAsync(LocationId.Value, location);
        }
        else
        {
            // Додавання нової локації
            await LocationService.AddAsync(location);
        }
        Navigation.NavigateTo("/locations", forceLoad: true);
    }


    private void Cancel()
    {
        Navigation.NavigateTo("/locations");
    }

    private void HandleLocationChanged(LocationDto updatedLocation)
    {
        location.Latitute = updatedLocation.Latitute;
        location.Longitute = updatedLocation.Longitute;
    }
}
