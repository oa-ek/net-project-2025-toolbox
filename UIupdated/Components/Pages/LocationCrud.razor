@page "/locations"
@using Core.DTOs
@using UIinterface.Services
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Locations</PageTitle>

<h3>Locations</h3>

@if (locations == null)
{
    <p>Loading...</p>
}
else
{
    <div>
        <input type="text" @bind="searchTerm" placeholder="Search by name..." class="form-control mb-3" />
        <table class="table">
            <thead>
                <tr>
                    <th @onclick="() => SortBy(nameof(LocationDto.Id))">Id</th>
                    <th @onclick="() => SortBy(nameof(LocationDto.Name))">Name</th>
                    <th @onclick="() => SortBy(nameof(LocationDto.Description))">Description</th>
                    <th @onclick="() => SortBy(nameof(LocationDto.Latitute))">Latitude</th>
                    <th @onclick="() => SortBy(nameof(LocationDto.Longitute))">Longitude</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var location in PagedLocations)
                {
                    <tr>
                        <td>@location.Id</td>
                        <td>@location.Name</td>
                        <td>@location.Description</td>
                        <td>@location.Latitute</td>
                        <td>@location.Longitute</td>
                        <td>
                            <button class="btn btn-primary" @onclick="() => ViewWorkers(location.Id)">View Workers and Bosses</button>
                            <button class="btn btn-warning" @onclick="() => EditLocation(location.Id)">Edit</button>
                            <button class="btn btn-danger" @onclick="() => DeleteLocation(location.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center">
            <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!CanGoToPreviousPage)">Previous</button>
            <span>Page @currentPage of @totalPages</span>
            <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!CanGoToNextPage)">Next</button>
        </div>

        <div class="mt-3">
            <button class="btn btn-success" @onclick="AddLocation">Add New Location</button>
        </div>
    </div>
}

@code {
    private List<LocationDto> locations;
    private List<LocationDto> PagedLocations => locations
        .Where(l => string.IsNullOrEmpty(searchTerm) || l.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .OrderBy(SortExpression)
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    private string searchTerm = string.Empty;
    private string sortColumn = nameof(LocationDto.Id);
    private bool sortAscending = true;

    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages => (int)Math.Ceiling((double)locations.Count / pageSize);

    private bool CanGoToPreviousPage => currentPage > 1;
    private bool CanGoToNextPage => currentPage < totalPages;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            locations = (await LocationService.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading locations: {ex.Message}");
        }
    }

    private void ViewWorkers(int locationId)
    {
        Navigation.NavigateTo($"/locations/{locationId}/workers");
    }

    private void EditLocation(int locationId)
    {
        Navigation.NavigateTo($"/edit-location/{locationId}");
    }

    private async Task DeleteLocation(int locationId)
    {
        try
        {
            await LocationService.DeleteAsync(locationId);
            locations = (await LocationService.GetAllAsync()).ToList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error deleting location: {ex.Message}");
        }
    }

    private void AddLocation()
    {
        Navigation.NavigateTo("/add-location", forceLoad: true);
    }

    private void PreviousPage()
    {
        if (CanGoToPreviousPage)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (CanGoToNextPage)
        {
            currentPage++;
        }
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private Func<LocationDto, object> SortExpression => sortColumn switch
    {
        nameof(LocationDto.Id) => l => l.Id,
        nameof(LocationDto.Name) => l => l.Name,
        nameof(LocationDto.Description) => l => l.Description,
        nameof(LocationDto.Latitute) => l => l.Latitute,
        nameof(LocationDto.Longitute) => l => l.Longitute,
        _ => l => l.Id
    };
}

