@page "/locations"
@using Core.DTOs
@using UIinterface.Services
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer


<PageTitle>Locations</PageTitle>

<div class="page-container">
    <h3 class="title">Locations</h3>

    @if (locations == null)
    {
        <p class="loading-text">Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var location in locations)
                {
                    <tr>
                        <td>@location.Id</td>
                        <td>@location.Name</td>
                        <td>@location.Description</td>
                        <td>@location.Latitute</td>
                        <td>@location.Longitute</td>
                        <td>
                            <button class="btn btn-edit" @onclick="() => ViewWorkers(location.Id)">View 🔎</button>
                            <button class="btn btn-edit" @onclick="() => EditLocation(location.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeleteLocation(location.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="form-actions">
            <button class="btn btn-add" @onclick="AddLocation">➕ Add New Location</button>
            <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
        </div>
    }
</div>
@code {
    private List<LocationDto> locations;

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/other");
    }

    protected override async Task OnInitializedAsync()
    {
        locations = (await LocationService.GetAllAsync()).ToList();
    }

    private void ViewWorkers(int locationId)
    {
        Navigation.NavigateTo($"/locations/{locationId}/workers");
    }

    private void EditLocation(int locationId)
    {
        Navigation.NavigateTo($"/edit-location/{locationId}");
    }

    private async Task DeleteLocation(int locationId)
    {
        await LocationService.DeleteAsync(locationId);
        locations = (await LocationService.GetAllAsync()).ToList();
        StateHasChanged();
    }

    private void AddLocation()
    {
        Navigation.NavigateTo("/add-location", forceLoad: true);
    }
}





