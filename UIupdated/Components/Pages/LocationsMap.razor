@page "/locations-map"
@using Core.DTOs
@using UIinterface.Services
@inject LocationService LocationService
@inject PowerToolService PowerToolService
@inject HandToolService HandToolService
@inject BataryService BataryService
@inject WorkerService WorkerService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Boss,Worker")]
<h3>Карта локацій та інструментів</h3>

<!-- Панель пошуку -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text"
                   class="form-control"
                   placeholder="Пошук локації або інструменту..."
                   @bind="searchTerm"
                   @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                <i class="fas fa-times"></i> Очистити
            </button>
        </div>

        <!-- Підказки для пошуку -->
        @if (showSuggestions && suggestions.Any())
        {
            <div class="card mt-2 position-absolute" style="z-index: 1000; width: 100%; max-width: 500px;">
                <div class="list-group list-group-flush">
                    @foreach (var suggestion in suggestions.Take(8))
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => OnSuggestionSelected(suggestion)">
                            <div>
                                <strong>@suggestion.Title</strong>
                                <br />
                                <small class="text-muted">@suggestion.Description</small>
                            </div>
                            <span class="badge bg-@(suggestion.Type == "location" ? "primary" : "secondary")">
                                @(suggestion.Type == "location" ? "Локація" : "Інструмент")
                            </span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-md-6">
        <div class="d-flex gap-2">
            <button class="btn btn-info" @onclick="ShowAllLocations">
                <i class="fas fa-map-marker-alt"></i> Показати всі локації
            </button>
            <button class="btn btn-success" @onclick="RefreshMap">
                <i class="fas fa-refresh"></i> Оновити карту
            </button>
        </div>
    </div>
</div>

<!-- Карта на всю ширину екрану -->
@if (locations == null)
{
    <div>
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Завантаження...</span>
        </div>
    </div>
}
else
{
    <div id="locations-view-map"
         style="height: 500px; width: 100vw; margin-left: calc(-50vw + 50%);"></div>
}

<!-- Інформаційна панель інструменту -->
@if (selectedTool != null)
{
    <div class="card mt-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-@(GetToolIcon(selectedTool.Type)) text-secondary"></i>
                @selectedTool.Name
            </h5>
        </div>
        <div class="card-body">
            <p>
                <strong>Тип:</strong> @GetToolTypeDisplayName(selectedTool.Type)
                <br />
                @if (!string.IsNullOrEmpty(selectedTool.SerialNumber))
                {
                    <strong>SN:</strong> @selectedTool.SerialNumber
                    <br />
                }
                <strong>Статус:</strong>
                <span class="badge bg-@(selectedTool.Status == "В користуванні" ? "warning" : "success")">
                    @selectedTool.Status
                </span>
                @if (!string.IsNullOrEmpty(selectedTool.WorkerName))
                {
                    <br />
                    <strong>Працівник:</strong> @selectedTool.WorkerName
                }
            </p>
        </div>
    </div>
}

<!-- Статистика -->
@if (locations != null && locations.Any())
{
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-primary">@locations.Count</h5>
                    <p class="card-text">Всього локацій</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-success">@totalTools</h5>
                    <p class="card-text">Всього інструментів</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-warning">@toolsInUse</h5>
                    <p class="card-text">В користуванні</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title text-info">@availableTools</h5>
                    <p class="card-text">Доступно</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LocationDto> locations = new();
    private List<PowerToolDto> allPowerTools = new();
    private List<HandToolDto> allHandTools = new();
    private List<BataryDto> allBataries = new();
    private List<WorkerDto> allWorkers = new();

    private string searchTerm = "";
    private bool showSuggestions = false;
    private List<SearchSuggestion> suggestions = new();

    // Для панелі інструменту
    private ToolInfo selectedTool;

    // Статистика
    private int totalTools = 0;
    private int toolsInUse = 0;
    private int availableTools = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocationsAsync();
        await LoadAllToolsAsync();
        await CalculateStatistics();
        await LoadAllWorkersAsync();
    }
    private async Task LoadAllToolsAsync()
    {
        allPowerTools = (await PowerToolService.GetAllAsync()).ToList();
        allHandTools = (await HandToolService.GetAllAsync()).ToList();
        allBataries = (await BataryService.GetAllAsync()).ToList();
    }

    private async Task LoadAllWorkersAsync()
    {
        allWorkers = (await WorkerService.GetAllAsync()).ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && locations.Any())
        {
            await InitializeMap();
        }
    }

    private async Task LoadLocationsAsync()
    {
        locations = (await LocationService.GetAllAsync()).ToList();
    }

    private async Task CalculateStatistics()
    {
        var powerTools = await PowerToolService.GetAllAsync();
        var handTools = await HandToolService.GetAllAsync();
        var bataries = await BataryService.GetAllAsync();

        totalTools = powerTools.Count() + handTools.Count() + bataries.Count();
        toolsInUse = powerTools.Count(t => t.LastWorkerId.HasValue)
                   + handTools.Count(t => t.LastWorkerId.HasValue)
                   + bataries.Count(t => t.LastWorkerId.HasValue);
        availableTools = totalTools - toolsInUse;
    }

    private async Task RefreshMap()
    {
        await LoadLocationsAsync();
        await LoadAllToolsAsync();
        await CalculateStatistics();
        await LoadAllWorkersAsync();
        selectedTool = null;
        StateHasChanged();
        await InitializeMap();
    }

    private void ClearSearch()
    {
        searchTerm = "";
        showSuggestions = false;
        suggestions.Clear();
        selectedTool = null;
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        await DoSearch();
    }

    private async Task DoSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            showSuggestions = false;
            suggestions.Clear();
            return;
        }

        // Пошук локацій
        var locMatches = locations
            .Where(l => l.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .Select(l => new SearchSuggestion
                {
                    Type = "location",
                    Title = l.Name,
                    Description = l.Description,
                    LocationId = l.Id
                });

        // Пошук інструментів
        var powerTools = await PowerToolService.SearchToolsAsync(searchTerm);
        var handTools = await HandToolService.SearchToolsAsync(searchTerm);
        var bataries = await BataryService.SearchToolsAsync(searchTerm);

        var toolMatches = powerTools.Select(t => new SearchSuggestion
            {
                Type = "tool",
                Title = t.ToolTypeName ?? t.SerialNumber,
                Description = $"PowerTool SN: {t.SerialNumber}",
                LocationId = t.LastLocationId ?? 0
            })
        .Concat(handTools.Select(t => new SearchSuggestion
            {
                Type = "tool",
                Title = t.Name,
                Description = $"HandTool: {t.ToolTypeName}",
                LocationId = t.LastLocationId
            }))
        .Concat(bataries.Select(t => new SearchSuggestion
            {
                Type = "tool",
                Title = t.BataryModelName ?? t.SerialNumber,
                Description = $"Batary SN: {t.SerialNumber}",
                LocationId = t.LastLocationId
            }));

        suggestions = locMatches.Concat(toolMatches).Take(10).ToList();
        showSuggestions = suggestions.Any();
    }

    private async Task OnSuggestionSelected(SearchSuggestion suggestion)
    {
        showSuggestions = false;
        searchTerm = suggestion.Title;

        // Якщо це інструмент — знайти і показати його
        if (suggestion.Type == "tool")
        {
            ToolInfo toolInfo = null;
            toolInfo = allPowerTools
                .Where(t => t.SerialNumber == suggestion.Title || t.ToolTypeName == suggestion.Title)
                .Select(t => new ToolInfo
                    {
                        Id = t.Id,
                        Type = "PowerTool",
                        Name = t.ToolTypeName ?? t.SerialNumber,
                        SerialNumber = t.SerialNumber,
                        Status = t.LastWorkerId.HasValue ? "В користуванні" : "Доступний",
                        WorkerName = t.LastWorkerId.HasValue ? GetWorkerNameSync(t.LastWorkerId.Value) : null
                    }).FirstOrDefault()
                ?? allHandTools
                .Where(t => t.Name == suggestion.Title)
                .Select(t => new ToolInfo
                    {
                        Id = t.Id,
                        Type = "HandTool",
                        Name = t.Name,
                        SerialNumber = null,
                        Status = t.LastWorkerId.HasValue ? "В користуванні" : "Доступний",
                        WorkerName = t.LastWorkerId.HasValue ? GetWorkerNameSync(t.LastWorkerId.Value) : null
                    }).FirstOrDefault()
                ?? allBataries
                .Where(t => t.BataryModelName == suggestion.Title || t.SerialNumber == suggestion.Title)
                .Select(t => new ToolInfo
                    {
                        Id = t.Id,
                        Type = "Batary",
                        Name = t.BataryModelName ?? t.SerialNumber,
                        SerialNumber = t.SerialNumber,
                        Status = t.LastWorkerId.HasValue ? "В користуванні" : "Доступний",
                        WorkerName = t.LastWorkerId.HasValue ? GetWorkerNameSync(t.LastWorkerId.Value) : null
                    }).FirstOrDefault();

            selectedTool = toolInfo;
            StateHasChanged();
        }
        else
        {
            selectedTool = null;
        }
    }

    private async Task ShowAllLocations()
    {
        selectedTool = null;
        await InitializeMap();
    }

    private async Task InitializeMap()
    {
        await JSRuntime.InvokeVoidAsync(
            "initializeLocationsMapWithTools",
            locations,
            allPowerTools,
            allHandTools,
            allBataries,
            DotNetObjectReference.Create(this)
        );
    }

    [JSInvokable]
    public async Task OnToolMarkerClicked(string type, int toolId)
    {
        ToolInfo toolInfo = null;

        switch (type)
        {
            case "PowerTool":
                var pt = allPowerTools.FirstOrDefault(t => t.Id == toolId);
                if (pt != null)
                {
                    toolInfo = new ToolInfo
                        {
                            Id = pt.Id,
                            Type = "PowerTool",
                            Name = pt.ToolTypeName ?? pt.SerialNumber,
                            SerialNumber = pt.SerialNumber,
                            Status = pt.LastWorkerId.HasValue ? "В користуванні" : "Доступний",
                            WorkerName = pt.LastWorkerId.HasValue ? GetWorkerNameSync(pt.LastWorkerId.Value) : null
                        };
                }
                break;
            case "HandTool":
                var ht = allHandTools.FirstOrDefault(t => t.Id == toolId);
                if (ht != null)
                {
                    toolInfo = new ToolInfo
                        {
                            Id = ht.Id,
                            Type = "HandTool",
                            Name = ht.Name,
                            SerialNumber = null,
                            Status = ht.LastWorkerId.HasValue ? "В користуванні" : "Доступний",
                            WorkerName = ht.LastWorkerId.HasValue ? GetWorkerNameSync(ht.LastWorkerId.Value) : null
                        };
                }
                break;
            case "Batary":
                var bt = allBataries.FirstOrDefault(t => t.Id == toolId);
                if (bt != null)
                {
                    toolInfo = new ToolInfo
                        {
                            Id = bt.Id,
                            Type = "Batary",
                            Name = bt.BataryModelName ?? bt.SerialNumber,
                            SerialNumber = bt.SerialNumber,
                            Status = bt.LastWorkerId.HasValue ? "В користуванні" : "Доступний",
                            WorkerName = bt.LastWorkerId.HasValue ? GetWorkerNameSync(bt.LastWorkerId.Value) : null
                        };
                }
                break;
        }

        selectedTool = toolInfo;
        StateHasChanged();
    }

    private string GetWorkerNameSync(int workerId)
    {
        var worker = allWorkers.FirstOrDefault(w => w.Id == workerId);
        if (worker != null)
            return $"{worker.FirstName} {worker.LastName}";
        return $"Працівник #{workerId}";
    }

    private string GetToolIcon(string type) => type switch
    {
        "PowerTool" => "bolt",
        "HandTool" => "wrench",
        "Batary" => "battery-full",
        _ => "tools"
    };

    private string GetToolTypeDisplayName(string type) => type switch
    {
        "PowerTool" => "Електроінструменти",
        "HandTool" => "Ручні інструменти",
        "Batary" => "Батареї",
        _ => type
    };

    // DTOs for UI
    public class ToolInfo
    {
        public int Id { get; set; }
        public string Type { get; set; }
        public string Name { get; set; }
        public string SerialNumber { get; set; }
        public string Status { get; set; }
        public string WorkerName { get; set; }
    }

    public class SearchSuggestion
    {
        public string Type { get; set; } // "location" or "tool"
        public string Title { get; set; }
        public string Description { get; set; }
        public int LocationId { get; set; }
    }
}
