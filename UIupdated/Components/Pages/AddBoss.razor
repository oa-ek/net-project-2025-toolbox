@page "/add-boss"
@using Core.DTOs
@using UIinterface.Services
@using UIupdated.Services
@inject BossService BossService
@inject LocationService LocationService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IUserService UserService
@inject BossService BossService
@inject NavigationManager Navigation
@inject WorkerService WorkerService
@inject SystemAdminService SystemAdminService

<PageTitle>Add Boss</PageTitle>

<div class="page-container">
    <h3 class="title">Add Boss</h3>

    <EditForm Model="boss" OnValidSubmit="SaveBoss">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="firstName" class="form-label">First Name</label>
            <InputText id="firstName" class="form-input" @bind-Value="boss.FirstName" />
        </div>

        <div class="form-group">
            <label for="lastName" class="form-label">Last Name</label>
            <InputText id="lastName" class="form-input" @bind-Value="boss.LastName" />
        </div>

        <div class="form-group">
            <label for="email" class="form-label">User Email</label>
            <InputSelect id="email" class="form-input" @bind-Value="boss.Email">
                <option value="">Select user email</option>
                @foreach (var user in users.OrderBy(u => u.Email))
                {
                    <option value="@user.Email">@user.Email</option>
                }
            </InputSelect>
        </div>


        <div class="form-group">
            <label for="phone" class="form-label">Phone</label>
            <InputText id="phone" class="form-input" @bind-Value="boss.Phone" />
        </div>

        <div class="form-group">
            <label for="password" class="form-label">Password</label>
            <InputText id="password" class="form-input" @bind-Value="boss.Password" type="password" />
        </div>

        <div class="form-group">
            <label class="form-label">Locations</label>
            @foreach (var location in locations)
            {
                <div class="checkbox-group">
                    <InputCheckbox @bind-Value="location.IsSelected" />
                    <label>@location.Name</label>
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-save">💾 Save</button>
            <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
        </div>
    </EditForm>
</div>

@code {
    private BossDto boss = new BossDto();
    private List<LocationViewModel> locations = new List<LocationViewModel>();
    private List<UserDto> users = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var allLocations = await LocationService.GetAllAsync();
        locations = allLocations.Select(l => new LocationViewModel
            {
                Id = l.Id,
                Name = l.Name,
                IsSelected = false
            }).ToList();

        // Отримати всіх користувачів
        users = (await UserService.GetAllUsersAsync()).ToList();

        // Вибрати зайняті email-и (Boss, Worker, SystemAdmin)
        var allBosses = await BossService.GetAllAsync();
        var allWorkers = await WorkerService.GetAllAsync();
        var allAdmins = await SystemAdminService.GetAllAsync();

        var occupiedEmails = new HashSet<string>(
            allBosses.Select(b => b.Email)
            .Concat(allWorkers.Select(w => w.Email))
            .Concat(allAdmins.Select(a => a.Email)),
            StringComparer.OrdinalIgnoreCase
        );

        // Доступні тільки ті, хто не має ролей і не зайнятий
        users = users
            .Where(u => string.IsNullOrEmpty(u.Email) || !occupiedEmails.Contains(u.Email))
            .Where(u => u.Roles == null || u.Roles.Count == 0)
            .ToList();

        isLoading = false;
    }


    private async Task SaveBoss()
    {
        var selectedLocations = locations.Where(l => l.IsSelected).Select(l => new LocationDto { Id = l.Id }).ToList();
        boss.Locations = selectedLocations;

        await BossService.AddAsync(boss);

        // Призначити роль Boss
        var user = await UserService.GetUserByEmailAsync(boss.Email);
        if (user != null)
        {
            await UserService.AssignRoleBossAsync(user.Id);
        }

        Navigation.NavigateTo("/bosses");
    }


    private void GoBack()
    {
        Navigation.NavigateTo("/bosses");
    }

    public class LocationViewModel
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public bool IsSelected { get; set; }
    }
}
