@page "/tooltypes"
@using Core.DTOs
@using UIinterface.Services
@inject ToolTypeService ToolTypeService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Tool Types</PageTitle>

<div class="page-container">
    <h3 class="title">Tool Types</h3>

    @if (isLoading)
    {
        <p class="loading-text">Loading...</p>
    }
    else
    {
        <table class="styled-table">
            <thead>
                <tr>
                    <th class="table-header">Name</th>
                    <th class="table-header">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var toolType in toolTypes)
                {
                    <tr>
                        <td class="table-cell">@toolType.Name</td>
                        <td class="table-cell">
                            <button class="btn btn-edit" @onclick="() => EditToolType(toolType.Id)">✏️</button>
                            <button class="btn btn-delete" @onclick="() => DeleteToolType(toolType.Id)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-add" @onclick="AddToolType">➕ Add New Tool Type</button>
        <button type="button" class="btn btn-cancel" @onclick="GoBack">↩️ Back</button>
    }

    @if (isEditing || isAdding)
    {
        <EditForm Model="toolType" OnValidSubmit="SaveToolType">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="name" class="form-label">Name</label>
                <InputText id="name" class="form-input" @bind-Value="toolType.Name" />
                <ValidationMessage For="@(() => toolType.Name)" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">💾 Save</button>
                <button type="button" class="btn btn-cancel" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    }
</div>

@code {
    private List<ToolTypeDto> toolTypes = new();
    private ToolTypeDto toolType = new();
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isAdding = false;

    protected override async Task OnInitializedAsync()
    {
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
        isLoading = false;
    }

    private void AddToolType()
    {
        toolType = new();
        isAdding = true;
        isEditing = false;
    }

    private async Task EditToolType(int id)
    {
        toolType = await ToolTypeService.GetByIdAsync(id);
        isEditing = true;
        isAdding = false;
    }

    private async Task SaveToolType()
    {
        if (isEditing)
            await ToolTypeService.UpdateAsync(toolType.Id, toolType);
        else if (isAdding)
            await ToolTypeService.AddAsync(toolType);

        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
        isEditing = false;
        isAdding = false;
    }

    private async Task DeleteToolType(int id)
    {
        await ToolTypeService.DeleteAsync(id);
        toolTypes = (await ToolTypeService.GetAllAsync()).ToList();
    }

    private void Cancel()
    {
        isEditing = false;
        isAdding = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/tools");
    }
}
